<!-- Finalidade: Configurar o módulo e suas dependências. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <!-- Versão do formato do documento POM, não do Maven instalado. -->
  <modelVersion>4.0.0</modelVersion>
  <!-- Herda a configuração do POM identificado por estas coordenadas. -->
  <parent>
    <groupId>br.edu.soa</groupId>
    <artifactId>restaurante-soap</artifactId>
    <version>2.0.0</version>
  </parent>
  <artifactId>infraestrutura</artifactId>
  <packaging>jar</packaging>
  <dependencies>
    <dependency>
      <groupId>br.edu.soa</groupId>
      <artifactId>aplicacao</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <!-- Driver JDBC para conectar ao servidor MySQL. -->
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <!-- Mecanismo que acompanha e aplica as migrações do esquema. -->
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <!-- Suporte Flyway específico para o banco MySQL. -->
      <artifactId>flyway-mysql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <!-- Banco em memória usado pelos testes; não equivale a validar MySQL Server. -->
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <!-- API e suporte dos testes JUnit. -->
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
    <!-- Gera imagem QR code do nosso cardapio digital-->
      <groupId>com.google.zxing</groupId>
      <artifactId>core</artifactId>
      <version>3.5.3</version>
    </dependency>
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>javase</artifactId>
      <version>3.5.3</version>
    </dependency>
  </dependencies>
</project>
