      <fault name="ErroNegocio" message="tns:ErroNegocio"/>
    </operation>
  </portType>
  <!-- Relaciona as operações ao protocolo e ao formato SOAP. -->
  <binding name="PedidoServiceBinding" type="tns:PedidoServicePortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="abrirPedido">
