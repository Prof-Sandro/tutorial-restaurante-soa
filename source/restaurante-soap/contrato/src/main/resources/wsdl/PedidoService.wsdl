<?xml version="1.0" encoding="UTF-8"?>
<!-- Finalidade: Criar PedidoService.wsdl usando o XSD da aula 33. -->
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://restaurante.soa.edu.br/v2" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" targetNamespace="http://restaurante.soa.edu.br/v2" name="PedidoService">
  <!-- Relaciona os tipos XML usados pelas mensagens. -->
