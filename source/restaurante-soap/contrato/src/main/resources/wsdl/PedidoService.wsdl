    </operation>
  </binding>
  <!-- Agrupa as portas e o endereço de publicação. -->
  <service name="PedidoService">
    <port name="PedidoPort" binding="tns:PedidoServiceBinding">
      <soap:address location="http://localhost:8080/restaurante/soap/pedidos"/>
    </port>
  </service>
</definitions>
